# Per-app caller tokens. Setting this turns auth on.
# Comma form: appId:token,appId:token
# JSON form is safer if a token contains a colon.
# SWARM_APP_TOKENS=duelodds:replace-me,perfect-swarm:replace-me
# SWARM_AUTH_REQUIRED=true

# CORS Configuration (Optional comma-separated list of additional allowed origins; wildcard * is ignored)
# Defaults: https://the-perfect-swarm.onrender.com, https://duelodds.pages.dev, http://localhost:3000, http://127.0.0.1:3000
CORS_ALLOWED_ORIGINS=""
