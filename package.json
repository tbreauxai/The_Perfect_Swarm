{
  "name": "@perfect-swarm/core",
  "version": "1.0.0",
  "description": "Modular, portable, zero-overhead AI Swarm with continuous Qdrant learning cortex and guaranteed free-tier LLM calibration",
  "type": "module",
  "main": "./dist/swarm/index.cjs",
  "module": "./dist/swarm/index.js",
  "types": "./dist/swarm/index.d.ts",
  "bin": {
    "perfect-swarm": "./bin/cli.js"
  },
  "files": [
    "dist/swarm",
    "bin",
    "src/swarm"
  ],
  "exports": {
    ".": {
      "types": "./dist/swarm/index.d.ts",
      "import": "./dist/swarm/index.js",
      "require": "./dist/swarm/index.cjs",
      "default": "./src/swarm/index.ts"
    },
    "./core": {
      "types": "./dist/swarm/index.d.ts",
      "import": "./dist/swarm/index.js",
      "require": "./dist/swarm/index.cjs",
      "default": "./src/swarm/index.ts"
    },
    "./memory": {
      "types": "./dist/swarm/memory.d.ts",
      "import": "./dist/swarm/memory.js",
      "require": "./dist/swarm/memory.cjs",
      "default": "./src/swarm/memory.ts"
    },
    "./router": {
      "types": "./dist/swarm/router.d.ts",
      "import": "./dist/swarm/router.js",
      "require": "./dist/swarm/router.cjs",
      "default": "./src/swarm/router.ts"
    },
    "./lifecycle": {
      "types": "./dist/swarm/lifecycle.d.ts",
      "import": "./dist/swarm/lifecycle.js",
      "require": "./dist/swarm/lifecycle.cjs",
      "default": "./src/swarm/lifecycle.ts"
    },
    "./cache": {
      "types": "./dist/swarm/cache.d.ts",
      "import": "./dist/swarm/cache.js",
      "require": "./dist/swarm/cache.cjs",
      "default": "./src/swarm/cache.ts"
    },
    "./hierarchy": {
      "types": "./dist/swarm/hierarchy.d.ts",
      "import": "./dist/swarm/hierarchy.js",
      "require": "./dist/swarm/hierarchy.cjs",
      "default": "./src/swarm/hierarchy.ts"
    },
    "./loadBalancer": {
      "types": "./dist/swarm/loadBalancer.d.ts",
      "import": "./dist/swarm/loadBalancer.js",
      "require": "./dist/swarm/loadBalancer.cjs",
      "default": "./src/swarm/loadBalancer.ts"
    },
    "./engine": {
      "types": "./dist/swarm/engine.d.ts",
      "import": "./dist/swarm/engine.js",
      "require": "./dist/swarm/engine.cjs",
      "default": "./src/swarm/engine.ts"
    },
    "./profiler": {
      "types": "./dist/swarm/profiler.d.ts",
      "import": "./dist/swarm/profiler.js",
      "require": "./dist/swarm/profiler.cjs",
      "default": "./src/swarm/profiler.ts"
    },
    "./server": {
      "types": "./dist/swarm/server.d.ts",
      "import": "./dist/swarm/server.js",
      "require": "./dist/swarm/server.cjs",
      "default": "./src/swarm/server.ts"
    },
    "./tools": {
      "types": "./dist/swarm/tools/index.d.ts",
      "import": "./dist/swarm/tools.js",
      "require": "./dist/swarm/tools.cjs",
      "default": "./src/swarm/tools/index.ts"
    },
    "./parser": {
      "types": "./dist/swarm/parser.d.ts",
      "import": "./dist/swarm/parser.js",
      "require": "./dist/swarm/parser.cjs",
      "default": "./src/swarm/parser.ts"
    }
  },
  "scripts": {
    "dev": "tsx watch server.ts",
    "build:client": "vite build",
    "build:swarm": "tsx scripts/build-swarm.ts",
    "build": "npm run build:client && npm run build:swarm",
    "preview": "vite preview",
    "clean": "rm -rf dist server.js",
    "lint": "tsc --noEmit",
    "test:portable": "node --experimental-strip-types test-portable-swarm.ts",
    "test:simulation": "node --experimental-strip-types test-multi-app-simulation.ts",
    "test:dist": "node test-dist-import.mjs && node test-dist-import.cjs",
    "test:cli": "node test-cli.mjs",
    "test:server": "node test-sse-server.mjs",
    "test": "npm run test:portable && npm run test:simulation && npm run test:dist && npm run test:cli && npm run test:server",
    "start": "node --experimental-strip-types server.ts"
  },
  "dependencies": {
    "@google/genai": "^2.4.0",
    "@qdrant/js-client-rest": "^1.19.0",
    "@tailwindcss/vite": "^4.1.14",
    "@vitejs/plugin-react": "^5.0.4",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "vite": "^6.2.3",
    "zod": "^4.6.3",
    "zod-to-json-schema": "^3.25.2"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.20.2",
    "autoprefixer": "^10.4.21",
    "esbuild": "^0.25.0",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2",
    "vite": "^6.2.3",
    "vitest": "^5.0.0"
  }
}
